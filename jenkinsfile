pipeline{
    agent any
    environment{
        FLASK_APP = 'main.py'
    }
    parameters{
        string(name: 'name', defaultValue:'environment name' , description: 'Enter the environment name')
        booleanParam(name: 'deploy', defaultValue: false, description: 'Deploy to environment?') 
    }
    stages{
        stage('clear'){
            steps{
                deleteDir()
            }
        }
        stage('Checkout Code'){
        steps{
            script{
                
                if(params.deploy){
                    
                    echo "Deploying to ${params.name} environment"
                    sh """  
                    git clone https://github.com/Greybash/jenkins_practice.git
                    cd jenkins_practice
                   
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirement.txt
                    
                    python ${env.FLASK_APP} &
                
                    """
                    return
        }
                else {
                    echo "Not deploying to any environment"
            }

    }
        

    }}
            stage('Trigger Choice Job'){
                steps{
                    build job:'choice' , parameters: [string(name: 'CHOICE_PARAM', value: 'option3')]
                }
            }
    
    
    }}