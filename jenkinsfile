pipeline{
    agent any
    environment{
        FLASK_APP = 'main.py'
    }
    parameters{
        string(name: 'name', defaultValue:'environment name' , description: 'Enter the environment name')
        booleanParam(name: 'deploy', defaultValue: false, description: 'Deploy to environment?') 
    }
    stages{
        stage('Checkout Code'){
        script{
            if(params.deploy){
                echo "Deploying to ${params.name} environment"
                sh """  
                git clone https://github.com/Greybash/jenkins_practice.git
                cd jenkins_practice
                pip install -r requirements.txt
                python ${env.FLASK_APP}
                
                """
        }
        else {
            echo "Not deploying to any environment"
        }

    }


}